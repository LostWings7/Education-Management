# ==============================================================================
# Environment Configuration for Education Management Portal
# Closed-Loop Academic Intelligence Platform
# ==============================================================================

# Core Django Settings
SECRET_KEY=django-insecure-closed-loop-academic-intelligence-portal-secret-key-2026
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,testserver

# Database Configuration (defaults to SQLite db.sqlite3)
# DATABASE_URL=sqlite:///db.sqlite3

# Demo & Presentation Modes (Enables 12-Step Katherine Johnson Academic Rescue Showcase)
DEMO_MODE=True
JUDGE_MODE=False

# AI Academic Intelligence Configuration (Optional)
# If GEMINI_API_KEY is unset, the system operates seamlessly via FallbackHeuristicProvider.
# GEMINI_API_KEY=your-gemini-api-key-here
AI_PROVIDER=fallback
AI_MODEL_FAST=gemini-2.5-flash
AI_MODEL_DEEP=gemini-2.5-pro
AI_TEMPERATURE=0.2
AI_TIMEOUT_SECONDS=15
